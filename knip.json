{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": {
    "interface": false,
    "type": false
  },
  "tags": ["-lintignore"],
  "workspaces": {
    ".": {
      "entry": [
        "package.json",
        ".github/workflows/*.{yml,yaml}",
        ".github/actions/*/action.{yml,yaml}"
      ]
    },
    "packages/language-support": {
      "entry": ["src/tests/benchmarks/*.benchmark.ts"],
      "project": ["src/**/*.ts", "!src/generated-parser/**"],
      "ignoreBinaries": ["antlr4"]
    },
    "packages/language-server": {},
    "packages/lint-worker": {
      "project": ["src/**/*.ts"]
    },
    "packages/query-tools": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/react-codemirror": {
      "entry": ["src/**/*.test.{ts,tsx}", "src/**/*.spec.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "*.ts"]
    },
    "packages/react-codemirror-playground": {},
    "packages/vscode-extension": {
      "entry": [
        "src/extension.ts",
        "src/webviews/controllers/*.{ts,tsx}",
        "tests/runApiAndUnitTests.ts",
        "tests/runWebviewTests.ts",
        "tests/testRunner.ts",
        "tests/testRunnerDebug.ts",
        "tests/specs/**/*.spec.ts",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.{ts,tsx,mts}", "tests/**/*.ts", "test/**/*.ts"],
      "ignore": ["tests/fixtures/**"],
      "ignoreBinaries": ["copy-lint-worker"]
    }
  },
  "ignore": ["vendor/**/*"],
  "ignoreBinaries": ["package", "dev"]
}
