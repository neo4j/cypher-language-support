{
  "*.tsx": ["oxfmt", "oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern"],
  "*.jsx": ["oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern"],
  "*.ts": ["oxfmt", "oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern"],
  "*.js": ["oxlint --fix --max-warnings 0 --no-error-on-unmatched-pattern"],
