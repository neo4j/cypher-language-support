/**
 * Shared Config file for API Extractor.  For more info, please visit: https://api-extractor.com
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",

  "mainEntryPointFilePath": "<unscopedPackageName>",

  "newlineKind": "lf",

  "compiler": {
    "tsconfigFilePath": "<projectFolder>/tsconfig.json"
  },

  "apiReport": {
    "enabled": true,
    "reportFileName": "api-report",
    "reportFolder": "<projectFolder>/api-extractor",
    // Forgotten exports are surfaced as a one-line "ae-forgotten-export" warning via
    // messages.extractorMessageReporting instead. Setting this to true inlines the
    // forgotten symbol's whole declaration, and then everything it references becomes
    // forgotten in turn - a cascade that can pull in a generated parser wholesale.
    "includeForgottenExports": false
  },

  "docModel": {
    "enabled": false
  },

  "dtsRollup": {
    "enabled": false
  },

  "tsdocMetadata": {
    "enabled": false
  },

  "messages": {
    "compilerMessageReporting": {
      "default": {
        // "error" rather than "warning": a TypeScript diagnostic during the analysis
        // means the .d.ts we are describing may be wrong, so it should fail the build
        // outright rather than land in the report. There are currently zero of these.
        "logLevel": "error",
        "addToApiReportFile": false
      }
    },
    "extractorMessageReporting": {
      // addToApiReportFile routes a message INTO the committed report instead of the
      // build log. That is the whole enforcement mechanism: the report is committed and
      // CI re-runs API Extractor with --ci, so any change to the set of warnings makes
      // the report differ and fails the build. A log line would just get lost.
      "default": {
        "logLevel": "warning",
        "addToApiReportFile": true
      },

      // Ignored. Every warning line embeds a file:line from the emitted .d.ts, and
      // those line numbers shift whenever unrelated code above them moves - so tracking
      // these occurrences would fail CI spuriously.
      "ae-undocumented": {
        "logLevel": "none"
      },

      // Ignored for now - to be revisited.
      "ae-missing-release-tag": {
        "logLevel": "none"
      }
    },

    "tsdocMessageReporting": {
      "default": {
        "logLevel": "warning",
        "addToApiReportFile": true
      }
    }
  }
}
